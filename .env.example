# Ambiente de execução
ENVIRONMENT=development

# Banco de dados PostgreSQL
# Convenção de nomes: familia_dev (dev) e familia_prod (prod)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=familia_dev

# CORS — origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Keycloak — autenticação OIDC
# Configurado na infraestrutura existente; clients dev e prod já provisionados
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=

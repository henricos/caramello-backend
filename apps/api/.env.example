# Ambiente de execução
ENVIRONMENT=development

# Banco de dados PostgreSQL
# Nomenclatura: caramello (prod), caramello_dev (dev — também usado para testes de integração via rollback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=caramello_dev

# CORS — origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Keycloak — autenticação OIDC
# Configurado na infraestrutura existente; clients dev e prod já provisionados
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=

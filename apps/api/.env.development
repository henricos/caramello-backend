# .env.development — versioned dev-only defaults for apps/api.
#
# This file is committed on purpose (see the root .gitignore — `.env.development`
# is the one dotenv variant excepted from the blanket `.env*` ignore rule).
# It is NEVER auto-loaded by the app itself (`core/config.py`'s `Settings` has
# no `env_file` — see that module's docstring); whatever launches the server
# must source it first, e.g.:
#
#   set -a && source .env.development && set +a
#   uv run python -m caramello_api --reload
#
# Two kinds of value live here, both safe to commit:
#   1. Throwaway local dev values (the pgembed DSN below, the mock OIDC
#      issuer) — meaningless outside this machine's ephemeral dev services.
#   2. References to variables the developer already exports elsewhere (shell
#      profile, direnv, a secret manager). The raw secret is never written
#      here, only `${VAR:-fallback}` indirection, resolved by the shell at
#      `source` time.

# --- Postgres (embedded pgembed dev server) ---
# Start it first, in a dedicated terminal:
#   uv run python -m caramello_api.shared.db_dev_server
# then update the line below with the DSN it prints. A local, uncommitted diff
# on just this line is expected and fine — the path is machine-specific and
# this is an ephemeral dev database, never production.
DATABASE_URL=postgresql+asyncpg://postgres:@/caramello_dev?host=/home/developer/github/henricos/caramello/apps/api/.pgembed-data

APP_ENV=development

# --- OIDC provider ---
# The full realm URL (issuer). The fallback points at the local mock OIDC
# provider, which arrives in a later phase; export AUTH_OIDC_ISSUER in your own
# shell to aim at a real Keycloak instead, e.g.
# https://keycloak.exemplo.com/realms/caramello.
AUTH_OIDC_ISSUER=${AUTH_OIDC_ISSUER:-http://localhost:8790}
AUTH_OIDC_AUDIENCE=caramello-api

# --- Shared data folder ---
# In a container this is always /data; locally that path is not writable
# without root, so dev points at the repository's own data folder.
DATA_DIR=../../data

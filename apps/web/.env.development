# .env.development — versioned dev-only configuration for apps/web.
#
# This file is committed on purpose (see the root .gitignore — `.env.development`
# is the one dotenv variant excepted from the blanket `.env*` ignore rule).
# Unlike apps/api, it IS loaded automatically: `next dev` and `next start` read
# it through Next.js's own `.env.development` convention, so there is no
# `set -a && source .env.development && set +a` step here.
#
# Because that loader is NOT a shell, only plain `${VAR}` indirection works.
# NEVER write `${VAR:-default}` in this file: bash-style fallbacks are not
# expanded and would be taken literally. Defaults belong in the typed validator
# (src/lib/env.ts), which also fails loudly, naming the variable, when something
# required is missing.
#
# Two kinds of value live here, both safe to commit:
#   1. Throwaway local dev values, meaningless outside a developer machine.
#   2. `${VAR}` indirection to variables the developer already exports elsewhere
#      (shell profile, direnv, a secret manager) for anything genuinely
#      sensitive. The raw secret is never written here.
#
# See docs/dev-setup.md for how to obtain each value, and
# "Configuration and environment variables" in the root AGENTS.md for the rule.

# --- Mount point and api ---
# The SAME base path production uses: the app lives at
# http://localhost:3000/caramello, never at the root, so base-path bugs show up
# in dev instead of only in the container.
APP_BASE_PATH=/caramello
# The api carries no version prefix and no base path in dev.
API_URL=http://localhost:8000

# --- OIDC provider and session secret ---
# Export these four in your own shell profile / secret manager before running
# `npm run dev` — never as literals in this repository. AUTH_OIDC_ISSUER points
# at the local mock provider in dev (http://localhost:8790) or at a real
# Keycloak realm; AUTH_SECRET signs and encrypts the session cookie and must
# have at least 32 characters (openssl rand -base64 33).
AUTH_OIDC_ISSUER=${AUTH_OIDC_ISSUER}
AUTH_OIDC_CLIENT_ID=${AUTH_OIDC_CLIENT_ID}
AUTH_OIDC_CLIENT_SECRET=${AUTH_OIDC_CLIENT_SECRET}
AUTH_SECRET=${AUTH_SECRET}

# Auth.js otherwise refuses to infer the host from the request. Harmless in dev,
# required in production behind the tunnel.
AUTH_TRUST_HOST=true
